# Port 5435, not 5432 -- docker-compose.yml's db service publishes on 5435
# because 5432/5433/5434 are commonly already claimed by a native Postgres.app
# or other local containers on dev machines (silently routes to the wrong
# Postgres instead of erroring -- discovered 2026-07-17).
DATABASE_URL=postgresql://kardashev:kardashev@localhost:5435/energy

# Required only for PJM data (free registration at dataminer2.pjm.com)
PJM_API_KEY=

# Required only for ERCOT large-load queue ingestion (vision extraction of a
# chart-only PDF -- see ingest/ercot_large_load.py). Get one at console.anthropic.com
ANTHROPIC_API_KEY=

# Comma-separated extra CORS origins (kardashevlabs.org subdomains allowed by default)
CORS_ORIGINS=

# Set to "development" to enable /docs and /redoc
ENVIRONMENT=production

# API rate limit per IP (requests per minute)
RATE_LIMIT_RPM=120
